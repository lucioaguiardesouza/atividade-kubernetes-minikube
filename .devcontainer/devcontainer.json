{
  "name": "Atividade Kubernetes - Minikube",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  // Pede uma máquina de 4 núcleos / 16 GB (a stack completa não cabe na de 8 GB)
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "latest"
    }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y socat && chmod +x scripts/*.sh",

  "forwardPorts": [8080, 3000],
  "portsAttributes": {
    "8080": { "label": "App Notas" },
    "3000": { "label": "Grafana" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-kubernetes-tools.vscode-kubernetes-tools", "redhat.vscode-yaml"]
    }
  }
}
